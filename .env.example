# ===========================================================================
# PROD stack configuration (the stable / "live" local stack) — STORY-024
# ===========================================================================
# This is the DEFAULT single-stack config. Copy it to .env and run ./deploy.sh up:
#   cp .env.example .env
#
# It is also the "prod" half of the concurrent dual-stack workflow: a stable "prod"
# stack (a released checkout, e.g. main) plus an active "dev" stack, running at the
# same time from DIFFERENTLY-NAMED folders. The prod stack uses the canonical host
# ports and the default PostgreSQL database. For the second (dev) stack, use the
# companion template `.env.dev.example` instead (offset ports + SQLite).
# See docs/devops-strategy.md § Running Two Stacks Concurrently.

# ---------------------------------------------------------------------------
# Stack identity & host ports
# ---------------------------------------------------------------------------
# Namespaces the built image tags (aiacu-backend:<STACK_NAME>, aiacu-web:<STACK_NAME>)
# so the dev stack builds its own images instead of overwriting the prod tag.
STACK_NAME=prod

# Host port for the backend (REST + MCP share this one port). Container port is
# fixed at 8000; this is only the localhost-published side.
BACKEND_PORT=8000

# Host port for the Web UI. Container port is fixed at 3000.
WEB_PORT=3000

# Host port for the PostgreSQL container. Used for external psql inspection; the
# app reaches Postgres internally at db:5432 regardless of this value.
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Backend application config (read by backend/app/core/config.py)
# ---------------------------------------------------------------------------

# Database — single switch between dialects.
# PostgreSQL (DEFAULT). deploy.sh activates the `postgres` Compose profile
# automatically whenever DATABASE_URL starts with `postgres`, so the db container
# starts on ./deploy.sh up. Each stack runs its OWN db container.
DATABASE_URL=postgresql+psycopg://app:app@db:5432/app
# SQLite (opt-in — no external service, no db container; runs in WAL mode):
# DATABASE_URL=sqlite:///data/app.db

# Storage
# Server-managed directory for attachment files and version snapshots.
# Must be outside the web root; paths are never constructed from user input.
ATTACHMENTS_DIR=/data/attachments

# CORS
# Space-separated list of allowed origins for the Web UI.
# MUST include this stack's own Web origin, i.e. http://localhost:<WEB_PORT>, AND the
# Docker-facing instance's origin, http://aiacu-web:3000 (web-docker — browsers in
# other projects' devcontainers, STORY-014).
CORS_ALLOWED_ORIGINS=http://localhost:3000 http://aiacu-web:3000

# Application
APP_TITLE=AI Agent Coordination Utility
APP_VERSION=1.0.0

# ---------------------------------------------------------------------------
# PostgreSQL container credentials (used under the `postgres` profile — the default)
# ---------------------------------------------------------------------------
# These initialise the local `db` container. They are used solely between
# containers on the host and are never transmitted off the machine. They must
# match the user/password/db in DATABASE_URL above. Ignored only if you switch
# DATABASE_URL to the SQLite opt-in.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# ---------------------------------------------------------------------------
# Frontend build-time config (baked into the SPA bundle at build)
# ---------------------------------------------------------------------------
# Origin the BROWSER uses to reach the backend (not the container network).
# MUST match this stack's own backend host port, i.e. http://localhost:<BACKEND_PORT>.
# This is baked into the SPA bundle at BUILD time, so changing it requires a rebuild
# (./deploy.sh up always builds first, so the next `up` picks it up).
VITE_API_BASE_URL=http://localhost:8000