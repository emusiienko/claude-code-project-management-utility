# ---------------------------------------------------------------------------
# Backend application config (read by backend/app/core/config.py)
# ---------------------------------------------------------------------------

# Database — single switch between dialects.
# SQLite (DEFAULT — no external service, no db container):
DATABASE_URL=sqlite:///data/app.db
# PostgreSQL (opt-in — also run the stack with the `postgres` profile;
# deploy.sh activates it automatically when DATABASE_URL starts with postgres):
# DATABASE_URL=postgresql+psycopg://app:app@db:5432/app

# Storage
# Server-managed directory for attachment files and version snapshots.
# Must be outside the web root; paths are never constructed from user input.
ATTACHMENTS_DIR=/data/attachments

# CORS
# Space-separated list of allowed origins for the Web UI.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Application
APP_TITLE=AI Agent Coordination Utility
APP_VERSION=1.0.0

# ---------------------------------------------------------------------------
# PostgreSQL container credentials (used ONLY under the `postgres` profile)
# ---------------------------------------------------------------------------
# These initialise the local `db` container. They are used solely between
# containers on the host and are never transmitted off the machine. They must
# match the user/password/db in DATABASE_URL above when Postgres is selected.
# Ignored entirely when running on the SQLite default.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# ---------------------------------------------------------------------------
# Frontend build-time config (baked into the SPA bundle at build)
# ---------------------------------------------------------------------------
# Origin the BROWSER uses to reach the backend (not the container network).
# For the local stack the backend is published at localhost:8000.
VITE_API_BASE_URL=http://localhost:8000
