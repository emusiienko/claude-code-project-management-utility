# ===========================================================================
# DEV stack configuration (the active development stack) — STORY-024
# ===========================================================================
# This is the "dev" half of the concurrent dual-stack workflow. Use it in the
# development checkout so it can run at the same time as a stable "prod" stack
# (see .env.example) without any port or resource collision. In THIS checkout:
#   cp .env.dev.example .env
# then run ./deploy.sh up.
#
# The two checkouts MUST live in DIFFERENTLY-NAMED folders — the folder basename is
# what gives each its own Compose project (isolated containers/networks/volumes).
# Every value below is chosen to NOT collide with the prod stack: a different
# STACK_NAME (own image tags), offset host ports, and matching browser-coupling
# URLs. The example offsets the app ports by +100 and Postgres by +1; any free
# ports work as long as the six interdependent values move together.
# See docs/devops-strategy.md § Running Two Stacks Concurrently.

# ---------------------------------------------------------------------------
# Stack identity & host ports
# ---------------------------------------------------------------------------
# Own image tags (aiacu-backend:dev / aiacu-web:dev) so the dev build never
# overwrites the prod tag.
STACK_NAME=dev

# Offset host ports so both stacks can publish at once. Container ports stay fixed.
BACKEND_PORT=8100
WEB_PORT=3100
POSTGRES_PORT=5433

# ---------------------------------------------------------------------------
# Backend application config (read by backend/app/core/config.py)
# ---------------------------------------------------------------------------

# Database — the dev stack defaults to SQLite (lighter: no db container, no profile,
# WAL mode). Switch to its OWN PostgreSQL container by uncommenting the postgres URL
# below — each stack runs a SEPARATE db container, so POSTGRES_PORT (5433) only
# differs for external psql access; the internal URL still targets db:5432.
DATABASE_URL=sqlite:///data/app.db
# DATABASE_URL=postgresql+psycopg://app:app@db:5432/app

# Storage
ATTACHMENTS_DIR=/data/attachments

# CORS — MUST include this stack's own Web origin (matches WEB_PORT above).
CORS_ALLOWED_ORIGINS=http://localhost:3100

# Application
APP_TITLE=AI Agent Coordination Utility
APP_VERSION=1.0.0

# ---------------------------------------------------------------------------
# PostgreSQL container credentials (used only if you switch this stack to Postgres)
# ---------------------------------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# ---------------------------------------------------------------------------
# Frontend build-time config (baked into the SPA bundle at build)
# ---------------------------------------------------------------------------
# MUST match this stack's own BACKEND_PORT above, or the dev web UI calls the wrong
# backend. Baked at BUILD time, so ./deploy.sh up (which builds first) picks it up.
VITE_API_BASE_URL=http://localhost:8100
